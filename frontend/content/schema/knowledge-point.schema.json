{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://learn.paulfun.net/schema/knowledge-point.schema.json",
  "title": "KnowledgePoint",
  "description": "Mido Learning 知識點。列舉值（階段、領域、素養代碼、議題、學科路徑、專才／通才標籤）以 taxonomy/ 為準，由驗證腳本另做檢查。本檔負責欄位形狀。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "concept",
    "title",
    "status",
    "version",
    "discipline",
    "stage",
    "to_verify",
    "verify_notes",
    "prerequisites",
    "links",
    "link_notes",
    "competency",
    "ai",
    "idea",
    "guiding_questions",
    "scenario",
    "formats",
    "authors",
    "updated"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "概念 id + @ + 階段，例如 pm.breakdown@es。全庫唯一。",
      "pattern": "^[a-z]{2,8}\\.[a-z0-9]+@[a-z]{2,8}$"
    },
    "concept": {
      "type": "string",
      "description": "與 id 的 @ 前段相同。同一概念日後可有多個階段版本；這一輪每個概念只有一個階段。",
      "pattern": "^[a-z]{2,8}\\.[a-z0-9]+$"
    },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "review", "published"] },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "字串，避免 YAML 把 0.1 讀成數字。"
    },
    "discipline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "layer", "crosscutting"],
      "properties": {
        "path": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "layer": { "type": "string", "minLength": 1 },
        "crosscutting": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": { "type": "string", "minLength": 1 },
        "grades": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 12 },
          "description": "選填。P1 多數知識點不標年級，因為年級落點仍待核對。"
        }
      }
    },
    "curriculum_108": {
      "type": "object",
      "additionalProperties": false,
      "description": "只在國小、國中、高中填。大學不可出現這個欄位。代碼只允許 A1–C3。",
      "required": ["domains", "core_competencies", "issues"],
      "properties": {
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "core_competencies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[ABC][123]$" }
        },
        "issues": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "performances": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/perfCode" },
          "description": "選填。領綱學習表現原文代碼，不可自編。"
        },
        "contents": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/contentCode" },
          "description": "選填。領綱學習內容原文代碼，不可自編。"
        }
      }
    },
    "to_verify": {
      "type": "boolean",
      "description": "設計文件標了「需要核對」時為 true，並在 verify_notes 寫下要核對的句子。"
    },
    "verify_notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "prerequisites": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/kpId" }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["why", "how", "related", "deeper"],
      "properties": {
        "why": {
          "description": "往本質追問。每一項都必須是已存在的知識點 id。",
          "$ref": "#/definitions/idList"
        },
        "how": {
          "description": "往應用延伸。",
          "$ref": "#/definitions/idList"
        },
        "related": {
          "description": "平行相關。還沒有知識點的學門不要寫進這裡，改寫在 link_notes。",
          "$ref": "#/definitions/idList"
        },
        "deeper": {
          "description": "同一主線的下一個深度，可以有多條主線，所以是陣列。目標階段必須比自己後面。",
          "$ref": "#/definitions/idList"
        }
      }
    },
    "link_notes": {
      "type": "string",
      "minLength": 1,
      "description": "示範原稿的跨科句子，保留尚未建立知識點的學門名稱。"
    },
    "competency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specialist", "generalist"],
      "properties": {
        "specialist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "generalist": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delegable", "human_experience"],
      "properties": {
        "delegable": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "human_experience": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "idea": { "type": "string", "minLength": 1, "description": "核心概念。" },
    "guiding_questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "string", "minLength": 1 },
      "description": "至少 1 題、最多 4 題。不要為了湊數另寫題目。"
    },
    "scenario": { "type": "string", "minLength": 1, "description": "動手活動或生活情境。" },
    "goal": { "type": "string", "minLength": 1, "description": "選填。一句目標，家長和學生都看得懂。" },
    "review": { "type": "string", "minLength": 1, "description": "選填。家長看得到的檢核。" },
    "formats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slides"],
      "properties": {
        "slides": {
          "type": "array",
          "uniqueItems": true,
          "description": "既有教材的 componentId。P1 留空。",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$" }
        },
        "article": { "type": "string", "minLength": 1 },
        "exercise": { "type": "string", "minLength": 1 },
        "project": { "type": "string", "minLength": 1 },
        "ai_prompt": { "type": "string", "minLength": 1 },
        "game": { "type": "string", "minLength": 1 }
      }
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "選填。大人學習者不另開階段（D03），用 kid、adult、family 標讀者。沒寫代表尚未標。",
      "items": { "type": "string", "enum": ["kid", "adult", "family"] }
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "est_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["school", "source"],
      "description": "選填。只寫有來源的學校進度，不寫在家時間。",
      "properties": {
        "school": { "type": "string", "minLength": 1, "maxLength": 20 },
        "source": { "$ref": "#/definitions/sourceId" }
      }
    },
    "why": {
      "$ref": "#/definitions/circlePart",
      "description": "Why：為什麼學。和 links.why／links.how（知識點 id 清單）不同。review、published 必填（backfill 清單內只警告）。"
    },
    "how": {
      "$ref": "#/definitions/circlePart",
      "description": "How：怎麼學。和 links.why／links.how（知識點 id 清單）不同。review、published 必填（backfill 清單內只警告）。"
    },
    "what": {
      "$ref": "#/definitions/circlePart",
      "description": "What：學什麼。和 links.why／links.how（知識點 id 清單）不同。review、published 必填（backfill 清單內只警告）。"
    },
    "figures": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/figure" },
      "description": "由資料畫出的圖。只能用已實作的 type。"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "description": "review、published 至少 2 筆（驗證器檢查）。",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "publisher", "url", "accessed", "kind", "supports"],
        "properties": {
          "id": { "$ref": "#/definitions/sourceId" },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https?://" },
          "accessed": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "kind": {
            "enum": ["curriculum", "exam", "government", "textbook", "school_plan", "peer_reviewed", "reference", "aux"]
          },
          "supports": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "type": "object",
            "properties": { "level": { "const": "uni" } },
            "required": ["level"]
          }
        },
        "required": ["stage"]
      },
      "then": { "properties": { "curriculum_108": false } }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "type": "object",
            "properties": { "level": { "enum": ["es", "jh", "sh"] } },
            "required": ["level"]
          }
        },
        "required": ["stage"]
      },
      "then": { "required": ["curriculum_108"] }
    },
    {
      "if": {
        "properties": { "to_verify": { "const": true } },
        "required": ["to_verify"]
      },
      "then": { "properties": { "verify_notes": { "type": "array", "minItems": 1 } } }
    }
  ],
  "definitions": {
    "kpId": {
      "type": "string",
      "pattern": "^[a-z]{2,8}\\.[a-z0-9]+@[a-z]{2,8}$"
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/kpId" }
    },
    "sourceId": { "type": "string", "pattern": "^[a-z0-9-]{2,32}$" },
    "figureId": { "type": "string", "pattern": "^[a-z0-9-]{2,40}$" },
    "perfCode": {
      "type": "string",
      "pattern": "^(?:[\\u4e00-\\u9fff] )?(?:[0-9]{1,2}[a-z]?-(?:IV|III|II|V|I)|[a-z]{1,2}-(?:IV|III|II|Vc|V|I))-[0-9]{1,2}$",
      "description": "學習表現代碼。例：2-II-4、1b-III-1、涯 3b-V-1、tm-IV-1（自然科學）、d-IV-1（數學）、an-Vc-2（自然科學高中必修；Vc 是第五學習階段）。羅馬數字用拉丁字母。科目前綴與代碼之間一個空格。必須存在於 taxonomy/curriculum-108-codes.yaml。"
    },
    "contentCode": {
      "type": "string",
      "pattern": "^(?:[\\u4e00-\\u9fff] )?(?:[A-Za-z]{1,2}-(?:IV|III|II|V|I)-[0-9]{1,2}|[A-Z]-(?:[1-9]|1[0-2])[A-Z]?-[0-9]{1,2})$",
      "description": "學習內容代碼。例：Aa-I-1、家 Ca-IV-1、公 Bl-IV-2、涂 Da-IV-1、n-III-1、D-10-2、D-11A-1。羅馬數字用拉丁字母。科目前綴與代碼之間一個空格。必須存在於 taxonomy/curriculum-108-codes.yaml。"
    },
    "circlePart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heading", "sources"],
      "description": "黃金圈的一圈。body、items、checklist、figures、notes 至少要有一項（驗證器檢查）。",
      "properties": {
        "heading": { "type": "string", "minLength": 1, "maxLength": 20, "description": "不含「為什麼學：」等前綴，前綴由頁面加。" },
        "body": { "type": "array", "minItems": 1, "maxItems": 3, "items": { "type": "string", "minLength": 1 } },
        "qa": {
          "type": "object",
          "additionalProperties": false,
          "required": ["question", "answer", "source"],
          "properties": {
            "question": { "type": "string", "minLength": 1, "description": "必須等於 guiding_questions 其中一題。" },
            "answer": { "type": "string", "minLength": 1 },
            "source": { "$ref": "#/definitions/sourceId" }
          }
        },
        "items_title": { "type": "string", "minLength": 1 },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "text"],
            "properties": {
              "title": { "type": "string", "minLength": 1, "maxLength": 16 },
              "text": { "type": "string", "minLength": 1 },
              "example": { "type": "string", "minLength": 1 },
              "code": { "anyOf": [{ "$ref": "#/definitions/perfCode" }, { "$ref": "#/definitions/contentCode" }] }
            }
          }
        },
        "checklist_title": { "type": "string", "minLength": 1 },
        "checklist": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "minLength": 1, "maxLength": 12 }
        },
        "activity_figure": { "$ref": "#/definitions/figureId" },
        "figures": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/definitions/figureId" } },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/sourceId" },
          "description": "這一圈文字依據的 sources[].id。"
        }
      }
    },
    "figure": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "alt", "items", "relation", "source"],
          "properties": {
            "id": { "$ref": "#/definitions/figureId" },
            "alt": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "caption": { "type": "string", "minLength": 1 },
            "source": { "$ref": "#/definitions/sourceId" },
            "type": { "const": "compare" },
            "relation": { "enum": ["not_equal", "equal", "versus"] },
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 3,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["term"],
                "properties": {
                  "term": { "type": "string", "minLength": 1, "maxLength": 8 },
                  "reading": { "type": "string", "minLength": 1 },
                  "note": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "alt", "steps"],
          "properties": {
            "id": { "$ref": "#/definitions/figureId" },
            "alt": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "caption": { "type": "string", "minLength": 1 },
            "source": { "$ref": "#/definitions/sourceId" },
            "type": { "const": "flow" },
            "steps": {
              "type": "array",
              "minItems": 2,
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["text"],
                "properties": {
                  "actor": { "type": "string", "minLength": 1, "maxLength": 4 },
                  "text": { "type": "string", "minLength": 1, "maxLength": 10 }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "alt", "rows", "source"],
          "properties": {
            "id": { "$ref": "#/definitions/figureId" },
            "alt": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "caption": { "type": "string", "minLength": 1 },
            "source": { "$ref": "#/definitions/sourceId" },
            "type": { "const": "spelling" },
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "initial", "medial", "final", "tone", "result"],
                "properties": {
                  "kind": { "type": "string", "minLength": 1, "maxLength": 4 },
                  "initial": { "type": "string", "maxLength": 1 },
                  "medial": { "type": "string", "maxLength": 1 },
                  "final": { "type": "string", "maxLength": 1 },
                  "tone": { "enum": ["", "ˊ", "ˇ", "ˋ", "˙"] },
                  "result": { "type": "string", "minLength": 1, "maxLength": 2 }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "alt", "tones", "source"],
          "properties": {
            "id": { "$ref": "#/definitions/figureId" },
            "alt": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "caption": { "type": "string", "minLength": 1 },
            "source": { "$ref": "#/definitions/sourceId" },
            "type": { "const": "tone_chart" },
            "tones": {
              "type": "array",
              "minItems": 4,
              "maxItems": 5,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "mark", "contour", "example", "reading"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "alias": { "type": "string", "minLength": 1 },
                  "mark": { "enum": ["ˉ", "ˊ", "ˇ", "ˋ", "˙"] },
                  "contour": { "enum": ["high_level", "rising", "dipping", "falling", "neutral"] },
                  "example": { "type": "string", "minLength": 1, "maxLength": 2 },
                  "reading": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "type", "alt", "groups", "source"],
          "properties": {
            "id": { "$ref": "#/definitions/figureId" },
            "alt": { "type": "string", "minLength": 1 },
            "title": { "type": "string", "minLength": 1 },
            "caption": { "type": "string", "minLength": 1 },
            "source": { "$ref": "#/definitions/sourceId" },
            "type": { "const": "symbol_grid" },
            "groups": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "symbols"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "symbols": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string", "minLength": 1, "maxLength": 2 }
                  }
                }
              }
            },
            "highlight": {
              "type": "object",
              "additionalProperties": false,
              "required": ["symbols", "label"],
              "properties": {
                "symbols": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 2 } },
                "label": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      ]
    }
  }
}
